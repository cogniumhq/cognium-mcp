{
  "name": "@cognium/mcp-server",
  "version": "0.9.0",
  "description": "Model Context Protocol server exposing the circle-ir SAST engine as structured tools for LLM agents (Claude Desktop, Claude Code, Cursor, cognium-ai).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "mcp-server-cognium-dev": "dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/bin.js",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm --prefix ../.. run release:check",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "sast",
    "security",
    "static-analysis",
    "taint-analysis",
    "circle-ir",
    "cognium",
    "llm-tools",
    "claude"
  ],
  "author": {
    "name": "Cognium Labs",
    "url": "https://cognium.dev"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cogniumhq/cognium-mcp.git",
    "directory": "packages/mcp-server"
  },
  "homepage": "https://github.com/cogniumhq/cognium-mcp/tree/main/packages/mcp-server#readme",
  "bugs": {
    "url": "https://github.com/cogniumhq/cognium-mcp/issues"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@cognium/code-facts": "0.1.0",
    "@modelcontextprotocol/core": "^2.3.1",
    "@modelcontextprotocol/server": "^2.4.0",
    "circle-ir": "4.20.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "circle-ir-ai": ">=4.31.0"
  },
  "peerDependenciesMeta": {
    "circle-ir-ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
