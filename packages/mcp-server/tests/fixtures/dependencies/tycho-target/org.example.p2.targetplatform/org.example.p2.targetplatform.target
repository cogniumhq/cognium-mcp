<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<?pde version="3.8"?>
<target name="org.example.p2.targetplatform">
	<locations>
		<location includeAllPlatforms="false" includeConfigurePhase="true" includeMode="planner" includeSource="true" type="InstallableUnit">
			<unit id="org.eclipse.equinox.sdk.feature.group" version="0.0.0"/>
			<repository location="https://download.eclipse.test/releases/"/>
		</location>
		<location path="${project_loc:/org.example.p2.targetplatform}/maven.locations.target" type="Target"/>
	</locations>
</target>
