{
  "name": "cognium-mcp",
  "version": "0.0.0",
  "private": true,
  "description": "The Cognium MCP server and its editor plugins",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w packages/mcp-server",
    "typecheck": "npm run typecheck -w packages/mcp-server",
    "test": "npm run test -w packages/mcp-server",
    "test:coverage": "npm run test:coverage -w packages/mcp-server",
    "clean": "npm run clean -w packages/mcp-server",
    "lint": "eslint .",
    "check:pins": "node scripts/check-pins.mjs",
    "test:scripts": "node --test 'scripts/*.test.mjs' 'plugins/**/*.test.mjs'",
    "release:check": "npm run lint && npm run test:scripts && npm run build && npm run typecheck && npm run test:coverage && npm run publish:gate",
    "check:train": "node scripts/check-release-train.mjs",
    "publish:gate": "node scripts/publish-gate.mjs"
  },
  "author": {
    "name": "Cognium Labs",
    "url": "https://cognium.dev"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cogniumhq/cognium-mcp.git"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "typescript-eslint": "^8.18.0"
  }
}
